<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AutoTap"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Auto click · Ghi &amp; phát lại thao tác · Nhận diện hình ảnh"
            android:textSize="14sp" />

        <!-- 1. Quyền -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="1. Quyền &amp; bảng điều khiển" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mở cài đặt Trợ năng" />

                <Button
                    android:id="@+id/btnToggleUi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bật giao diện nổi" />

                <Button
                    android:id="@+id/btnAppInfo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Không bật được? Mở thông tin ứng dụng" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Nút kích hoạt -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="2. Nút combo &amp; bảng điều khiển" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="#22888888">

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_trigger"
                        android:contentDescription="Xem trước nút"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lblSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="4"
                    android:value="64"
                    android:valueFrom="32"
                    android:valueTo="160" />

                <TextView
                    android:id="@+id/lblAlpha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:value="85"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/lblBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="2"
                    android:value="34"
                    android:valueFrom="22"
                    android:valueTo="56" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEdge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vuốt từ cạnh TRÁI để mở danh sách combo (tắt = cạnh phải)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vị trí: kéo trực tiếp từng nút combo và bảng điều khiển trên màn hình (vị trí được ghi nhớ). Độ hiển thị 0% = nút tàng hình."
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnResetPos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đặt lại vị trí mặc định" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Thao tác -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="3. Combo (công tắc = hiện nút; chạm để chỉnh)" />

                <LinearLayout
                    android:id="@+id/listMacros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Hình ảnh -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="4. Nhận diện hình ảnh" />

                <Button
                    android:id="@+id/btnWatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bật theo dõi hình ảnh" />

                <TextView
                    android:id="@+id/lblScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="100"
                    android:value="500"
                    android:valueFrom="300"
                    android:valueTo="3000" />

                <LinearLayout
                    android:id="@+id/listTriggers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Hướng dẫn -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Hướng dẫn nhanh" />

                <TextView
                    android:id="@+id/txtGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
